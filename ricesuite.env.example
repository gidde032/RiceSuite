# RiceSuite — the one config file for all three pillars (ADR-001 Q14).
#
# Copy to `ricesuite.env` at the suite root (it is gitignored). Every variable
# is optional, keeps the exact name its pillar has always read, and is passed
# to that pillar unchanged. A variable already exported in your shell wins over
# this file. `RICESUITE_ENV=/path/to/other.env` (shell only) points RiceSuite
# at a different file, e.g. for a throwaway test setup, and
# `RICESUITE_RUN_DIR` (shell only; default `.ricesuite/` in the suite root)
# moves the launcher's state file used by `rice status` and `rice stop`.

# ─── Shared ─────────────────────────────────────────────────────────────────
# One key for all three Claude call sites: Searcher scoring, Clipper's opt-in
# header, Poster captions.
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Handoff directories (set by RiceSuite — see note) ─────────────────────
# RiceSuite derives all four handoff variables itself so the two ends of a
# stage can never disagree. Set at most the producer side of each stage:
#   Searcher → Clipper: RICESEARCHER_HANDOFF_DIR  (Clipper's RICECLIPPER_SEARCHER_INBOX follows)
#   Clipper → Poster:   RICECLIPPER_HANDOFF_DIR   (Poster's HANDOFF_DIR follows)
# Setting both ends of a stage to different paths, or both stages to one
# path, is refused.
# RICESEARCHER_HANDOFF_DIR=~/ricesearcher-handoff
# RICECLIPPER_HANDOFF_DIR=~/riceclipper-handoff
# RICECLIPPER_SEARCHER_INBOX=   (derived — leave unset)
# HANDOFF_DIR=                  (derived — leave unset)

# ─── RiceSearcher (see searcher/credentials.env.example) ───────────────────
# RICESEARCHER_DATA_DIR=~/.ricesearcher
# RICESEARCHER_PROFILES_DIR=~/.ricesearcher/profiles
# RICESEARCHER_SCORER_MODEL=claude-haiku-4-5
# RICESEARCHER_EMBED_MODEL=all-MiniLM-L6-v2
# ANTHROPIC_AUTH_TOKEN=   (alternative to ANTHROPIC_API_KEY for the scorer)

# ─── RiceClipper (see clipper/.env.example) ────────────────────────────────
# RICECLIPPER_HEADER_STYLE=generic-header
# RICECLIPPER_HEADER_MODEL=claude-sonnet-5
# RICECLIPPER_WHISPER_MODEL=small
# RICECLIPPER_WHISPER_DEVICE=cpu
# RICECLIPPER_WHISPER_COMPUTE=int8
# RICECLIPPER_WHISPER_CPU_THREADS=4
# RICECLIPPER_FFMPEG_THREADS=4
# TOKENIZERS_PARALLELISM=false

# ─── RicePoster (see poster/credentials.env.example and poster/README.md) ──
# Root for sessions/, debug/, media/, queue.jsonl, queue_media/,
# history.jsonl. Default: the poster/ checkout. During burn-in, point it at
# your existing RicePoster folder to use its logged-in sessions in place.
# RICEPOSTER_DATA_DIR=/path/to/existing/RicePoster
# POST_MODE=mock
# HEADLESS=true
# LOG_LEVEL=INFO
# SCHEDULER_ENABLED=true
# ACCOUNT_SLOTS=A,B,C
# CLIPPER_INGEST_STYLE=generic
# NOTIFY_SERVICE=none
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# SESSION_CHECK_TTL_S=21600
# PREFLIGHT_CHECK_PLATFORMS=instagram,tiktok
# INTER_SLOT_DELAY_MIN_S=60
# INTER_SLOT_DELAY_MAX_S=180
# FEED_DWELL_MIN_S=30
# FEED_DWELL_MAX_S=60
# Instagram media preparation and post-Share confirmation each allow up to 7.5 minutes.
# IG_UPLOAD_TIMEOUT_S=450
# Per-account (slot id in place of A):
# IG_ACCOUNT_A_NAME=Account A
# IG_ACCOUNT_A_ID=
# IG_ACCOUNT_A_TOKEN=
# TT_ACCOUNT_A_TOKEN=
