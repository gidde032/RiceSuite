# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment / secrets
.env
.env.*

# Model caches (faster-whisper downloads)
models/
# Vendored YuNet detector model is tracked (subject crop, ADR-001).
!render/models/
!render/models/**
*.bin
*.pt

# Rendered output (keep the dir, ignore contents)
outputs/*
!outputs/.gitkeep

# Per-job work dirs (uploads, generated ASS, renders)
.riceclipper_work/

# Subject-crop fixture clips (maintainer-local; see subject-crop-spec.md F5)
fixtures/landscape/

# Session-continuity handoff (not part of a fresh clone)
internal/

# Header-agent prompts: only the neutral seed is tracked. Maintainer-specific
# styles name real people and tie this repo to the accounts it serves, so they
# stay local and gitignored. Pinned by test_prompts.py.
prompts/*.json
!prompts/generic-header.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
