# RiceClipper — example environment configuration.
#
# Copy to `.env` in the repo root (it is gitignored) and fill in as needed. The
# server loads it automatically at startup (`uvicorn app.main:app`). Variables
# already exported in your shell take precedence over `.env`. Every variable is
# OPTIONAL: RiceClipper runs fully locally with none of them set. The only
# variable that enables any network activity is ANTHROPIC_API_KEY, and even then
# the header generator and the caption emoji picker are opt-in (each triggered
# only from its UI button).

# --- Optional header generator and caption emoji picker (SPEC §6.2, §5.1) ---
# The ONLY outbound network features, each run only by its button (✨ Generate,
# ✨ Suggest emoji). Leave unset to keep RiceClipper fully offline; the header
# and the caption emoji then stay manual. See SECURITY.md for exactly what is
# sent when you trigger either.
ANTHROPIC_API_KEY=

# Header style key (matches a file in prompts/). Default: generic-header
RICECLIPPER_HEADER_STYLE=generic-header
# Anthropic model used for header generation and the caption emoji picker
# (one setting for both). Default: claude-haiku-5-5
RICECLIPPER_HEADER_MODEL=claude-haiku-5-5

# --- Transcription (faster-whisper) -----------------------------------------
# Whisper model size (tiny/base/small/medium/large-v3). Default: small
RICECLIPPER_WHISPER_MODEL=small
# Inference device (cpu/cuda). Default: cpu
RICECLIPPER_WHISPER_DEVICE=cpu
# Compute type (int8/int8_float16/float16/float32). Default: int8
RICECLIPPER_WHISPER_COMPUTE=int8
# CPU worker threads for transcription. Default: gentle bound (~4)
RICECLIPPER_WHISPER_CPU_THREADS=4
# Silence a noisy HuggingFace tokenizer warning when set to false.
TOKENIZERS_PARALLELISM=false

# --- Rendering (ffmpeg) -----------------------------------------------------
# ffmpeg worker threads for encoding. Default: gentle bound (~4)
RICECLIPPER_FFMPEG_THREADS=4

# --- Local handoff directories (filesystem only; no network) ----------------
# Where RiceClipper WRITES finished batches for RicePoster to pull.
# Default: ~/riceclipper-handoff
RICECLIPPER_HANDOFF_DIR=~/riceclipper-handoff
# Where RiceClipper READS source clips selected by RiceSearcher. Must match
# RiceSearcher's RICESEARCHER_HANDOFF_DIR. Default: ~/ricesearcher-handoff
RICECLIPPER_SEARCHER_INBOX=~/ricesearcher-handoff
